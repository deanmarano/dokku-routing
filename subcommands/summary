#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$PLUGIN_ROOT/config"
source "$PLUGIN_ROOT/functions"

[[ "${1:-}" == routing:* ]] && shift
routing_parse_format "$@"

routing_load_levels

routing_list_apps >/dev/null
APPS="$(routing_list_apps)"
APP_COUNT="$(grep -c . <<<"$APPS" || true)"

# Inspecting a whole fleet takes long enough to look like a hang, so say what is
# happening before the wait rather than after it. On stderr: stdout is the
# report, and must stay parseable under --format json.
if [[ "$APP_COUNT" -gt 0 ]]; then
  if [[ "$APP_COUNT" -ge 10 ]]; then
    echo "-----> Inspecting $APP_COUNT apps, this takes a few seconds" >&2
  else
    echo "-----> Inspecting $APP_COUNT apps" >&2
  fi
fi

# Summarising every app is the one place where per-app `dokku *:report` calls
# dominate the runtime. Fetch each report for all apps up front instead, and
# warm the global lookups so the per-app subshells inherit them rather than
# each recomputing.
routing_prewarm_field proxy proxy-computed-type
routing_prewarm_field domains domains-app-vhosts
routing_prewarm_field ports ports-map
routing_prewarm_reports checks
routing_acme_apps >/dev/null
routing_trigger_exists || true

# Now that proxy:report is cached, we know which proxies are actually in use
# and can fetch only those adapters' reports rather than every proxy Dokku
# happens to have installed.
IN_USE=""
while read -r app; do
  [[ -z "$app" ]] && continue
  proxy="$(routing_app_proxy "$app")"
  [[ " $IN_USE " == *" $proxy "* ]] || IN_USE+=" $proxy"
done <<<"$APPS"

for proxy in $IN_USE; do
  routing_provider_exists "$proxy" && routing_provider_inspects "$proxy" &&
    routing_prewarm_reports "$proxy"
done
[[ " $IN_USE " == *" traefik "* ]] && routing_prewarm_reports docker-options

# For one app: current proxy, capability count, whether custom config is
# involved, and which targets it could move to without losing anything.
analyze() {
  local app="$1"
  local proxy detected caps target class
  local clean=() blocked=()

  proxy="$(routing_app_proxy "$app")"
  detected="$(routing_app_capabilities "$app" "$proxy")"
  caps="$(cut -f1 <<<"$detected" | grep -v '^$' | sort -u || true)"

  local custom="no"
  grep -q '^raw-config' <<<"$detected" && custom="yes"

  local target_list
  target_list="$(routing_list_providers | grep -vx "$proxy" || true)"

  while read -r target; do
    [[ -z "$target" ]] && continue
    local worst="portable"
    while read -r key; do
      [[ -z "$key" ]] && continue
      routing_classify "$key" "$target" "$(routing_capability_sources "$detected" "$key")" >/dev/null
      class="$ROUTING_CLASS"
      case "$class" in
        unsupported) worst="unsupported" ;;
        manual) [[ "$worst" != "unsupported" ]] && worst="manual" ;;
      esac
    done <<<"$caps"
    if [[ "$worst" == "unsupported" ]]; then
      blocked+=("$target")
    else
      clean+=("$target")
    fi
  done <<<"$target_list"

  # app <TAB> proxy <TAB> capcount <TAB> custom <TAB> clean <TAB> blocked
  #
  # Empty lists are written as "-", never as an empty field. Tab is an IFS
  # whitespace character, so `read` with IFS=$'\t' collapses a run of tabs into
  # one delimiter: an empty field in the middle silently shifts every later
  # value one column left. An app blocked from every target has no clean list,
  # and would otherwise be read back as movable to all of them.
  local clean_list blocked_list
  clean_list="$(IFS=,; echo "${clean[*]:-}")"
  blocked_list="$(IFS=,; echo "${blocked[*]:-}")"

  printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$app" "$proxy" "$(grep -c . <<<"$caps" || echo 0)" "$custom" \
    "${clean_list:--}" "${blocked_list:--}"
}

# Turn the "-" placeholder back into an empty list.
unplaceholder() {
  [[ "$1" == "-" ]] && return 0
  printf '%s' "$1"
}

ROWS=""
while read -r app; do
  [[ -z "$app" ]] && continue
  ROWS+="$(analyze "$app")"$'\n'
done <<<"$APPS"

emit_text() {
  if [[ -z "${APPS//[[:space:]]/}" ]]; then
    echo "No apps found."
    return
  fi

  printf '%-24s %-11s %5s %-8s %s\n' "APP" "PROXY" "CAPS" "CUSTOM" "CAN MOVE TO"
  printf '%-24s %-11s %5s %-8s %s\n' "---" "-----" "----" "------" "-----------"

  local app proxy count custom clean blocked
  while IFS=$'\t' read -r app proxy count custom clean blocked; do
    [[ -z "$app" ]] && continue
    clean="$(unplaceholder "$clean")"
    printf '%-24s %-11s %5s %-8s %s\n' "$app" "$proxy" "$count" "$custom" "${clean:-none}" | sed 's/,/, /g'
  done <<<"$ROWS"

  echo
  local any_blocked=0
  while IFS=$'\t' read -r app proxy count custom clean blocked; do
    blocked="$(unplaceholder "$blocked")"
    [[ -z "$app" || -z "$blocked" ]] && continue
    [[ $any_blocked -eq 0 ]] && { echo "Blocked moves"; echo "-------------"; any_blocked=1; }
    printf '  %-24s ❌ %s\n' "$app" "${blocked//,/, }"
  done <<<"$ROWS"
  [[ $any_blocked -eq 1 ]] && echo

  echo "Run 'dokku routing:report <app>' for detail, or 'dokku routing:plan <app> <proxy>' for a migration plan."
}

emit_json() {
  local app proxy count custom clean blocked first=1
  printf '{"apps":['
  while IFS=$'\t' read -r app proxy count custom clean blocked; do
    [[ -z "$app" ]] && continue
    clean="$(unplaceholder "$clean")"
    blocked="$(unplaceholder "$blocked")"
    [[ $first -eq 0 ]] && printf ','
    first=0
    printf '{"app":%s,"proxy":%s,"capability_count":%s,"custom_config":%s,"can_move_to":[%s],"blocked_for":[%s]}' \
      "$(routing_json_string "$app")" "$(routing_json_string "$proxy")" "${count:-0}" \
      "$([[ "$custom" == "yes" ]] && echo true || echo false)" \
      "$(tr ',' '\n' <<<"$clean" | grep -v '^$' | sed 's/.*/"&"/' | paste -sd, -)" \
      "$(tr ',' '\n' <<<"$blocked" | grep -v '^$' | sed 's/.*/"&"/' | paste -sd, -)"
  done <<<"$ROWS"
  printf ']}\n'
}

if [[ "$ROUTING_FORMAT" == "json" ]]; then
  emit_json
else
  emit_text
fi
