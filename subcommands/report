#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$PLUGIN_ROOT/config"
source "$PLUGIN_ROOT/functions"

[[ "${1:-}" == router:* ]] && shift
router_parse_format "$@"
set -- "${ROUTER_ARGS[@]:-}"

APP="${1:-}"

if [[ -z "$APP" ]]; then
  echo "Usage: dokku router:report <app> [--format json]" >&2
  exit 1
fi

if ! router_app_exists "$APP"; then
  echo "!     App $APP does not exist" >&2
  exit 1
fi

CURRENT="$(router_app_proxy "$APP")"
ENABLED="true"
router_app_proxy_enabled "$APP" || ENABLED="false"

DETECTED="$(router_app_capabilities "$APP" "$CURRENT")"
router_load_levels

# Every detected detail for one capability, joined for display.
details_for() {
  awk -F'\t' -v c="$1" '$1==c {printf "%s%s (%s)", sep, $2, $3; sep="; "}' <<<"$DETECTED"
}

used_caps() {
  # Registry order, restricted to what this app actually uses.
  local key
  while IFS='|' read -r key _ _ _; do
    grep -q "^${key}$(printf '\t')" <<<"$DETECTED" && echo "$key"
  done <<<"$(router_capability_registry)"
}

targets() {
  local provider
  for provider in $(router_list_providers); do
    [[ "$provider" == "$CURRENT" ]] && continue
    echo "$provider"
  done
}

emit_text() {
  local key label

  echo "=====> $APP routing report"
  echo
  printf '       Current proxy:      %s\n' "$CURRENT"
  printf '       Proxy enabled:      %s\n' "$ENABLED"
  if ! router_provider_exists "$CURRENT"; then
    printf '       Note:               no adapter for "%s"; only shared Dokku state was inspected\n' "$CURRENT"
  elif ! router_provider_inspects "$CURRENT"; then
    printf '       Note:               the %s adapter declares capabilities but does not inspect live config yet\n' "$CURRENT"
  fi
  echo

  echo "In use"
  echo "------"
  local any=0
  while read -r key; do
    [[ -z "$key" ]] && continue
    any=1
    label="$(router_capability_label "$key")"
    printf '  %-31s %s\n' "$label" "$(details_for "$key")"
  done <<<"$(used_caps)"
  [[ $any -eq 0 ]] && echo "  (nothing beyond proxy defaults)"

  echo
  echo "Portability"
  echo "-----------"
  # Emoji are double-width, so the counts table uses words to stay aligned.
  printf '  %-14s %8s %6s %7s %12s\n' "TARGET" "PORTABLE" "AUTO" "MANUAL" "UNSUPPORTED"

  local target class
  local -A counts
  while read -r target; do
    [[ -z "$target" ]] && continue
    counts=([portable]=0 [translatable]=0 [manual]=0 [unsupported]=0)
    while read -r key; do
      [[ -z "$key" ]] && continue
      class="$(router_classify "$key" "$target")"
      counts[$class]=$((counts[$class] + 1))
    done <<<"$(used_caps)"
    printf '  %-14s %8s %6s %7s %12s\n' "$target" \
      "${counts[portable]}" "${counts[translatable]}" "${counts[manual]}" "${counts[unsupported]}"
  done <<<"$(targets)"

  echo
  echo "  Run 'dokku router:plan $APP <target>' to see why."
}

emit_json() {
  local key target first

  printf '{"app":%s,"proxy":%s,"proxy_enabled":%s,"capabilities":[' \
    "$(router_json_string "$APP")" "$(router_json_string "$CURRENT")" "$ENABLED"

  first=1
  while IFS=$'\t' read -r key detail source; do
    [[ -z "$key" ]] && continue
    [[ $first -eq 0 ]] && printf ','
    first=0
    printf '{"key":%s,"label":%s,"detail":%s,"source":%s}' \
      "$(router_json_string "$key")" \
      "$(router_json_string "$(router_capability_label "$key")")" \
      "$(router_json_string "$detail")" "$(router_json_string "$source")"
  done <<<"$DETECTED"

  printf '],"portability":{'
  local tfirst=1
  while read -r target; do
    [[ -z "$target" ]] && continue
    [[ $tfirst -eq 0 ]] && printf ','
    tfirst=0
    printf '%s:[' "$(router_json_string "$target")"
    first=1
    while read -r key; do
      [[ -z "$key" ]] && continue
      [[ $first -eq 0 ]] && printf ','
      first=0
      printf '{"key":%s,"classification":%s,"target_support":%s,"note":%s}' \
        "$(router_json_string "$key")" \
        "$(router_json_string "$(router_classify "$key" "$target")")" \
        "$(router_json_string "$(router_provider_level "$target" "$key")")" \
        "$(router_json_string "$(router_provider_note "$target" "$key")")"
    done <<<"$(used_caps)"
    printf ']'
  done <<<"$(targets)"
  printf '}}\n'
}

if [[ "$ROUTER_FORMAT" == "json" ]]; then
  emit_json
else
  emit_text
fi
