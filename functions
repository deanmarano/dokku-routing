#!/usr/bin/env bash

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/capabilities"

# ---------------------------------------------------------------------------
# Dokku helpers
# ---------------------------------------------------------------------------

# Run a dokku command, swallowing failures. Plugins we ask about may not be
# installed, and a missing report is information, not an error.
routing_dokku() {
  "$DOKKU_BIN" "$@" 2>/dev/null || true
}

# True if a dokku command namespace exists on this host.
routing_dokku_has() {
  "$DOKKU_BIN" "$1" --help &>/dev/null || "$DOKKU_BIN" "$1" &>/dev/null
}

# Pull a single field out of a `dokku *:report` block.
#
#   routing_report_field "$report" "Nginx client max body size"
#
# Report lines are "       Nginx client max body size:    10m".
routing_report_field() {
  local report="$1" field="$2" line
  while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ "$line" == "$field:"* ]] || continue
    line="${line#"$field:"}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    echo "$line"
    return 0
  done <<<"$report"
  return 1
}

# --- Report cache -----------------------------------------------------------
#
# `dokku <plugin>:report` with no app returns every app in one invocation.
# Summarising 40 apps one call at a time costs minutes; pre-warming costs
# one call per plugin. Single-app commands skip the pre-warm and fetch just
# the app they need, so they pay nothing for this.

declare -gA ROUTING_REPORT=()
ROUTING_REPORT_BULK=""

# Fetch every app's report for each named plugin in a single call.
routing_prewarm_reports() {
  local plugin out line app
  for plugin in "$@"; do
    [[ " $ROUTING_REPORT_BULK " == *" $plugin "* ]] && continue
    ROUTING_REPORT_BULK+=" $plugin"

    out="$(routing_dokku "$plugin:report")"
    app=""
    while IFS= read -r line; do
      # Blocks are introduced by "=====> <app> <plugin> information".
      if [[ "$line" == "=====>"* ]]; then
        read -r _ app _ <<<"$line"
        ROUTING_REPORT["$plugin|$app"]=""
        continue
      fi
      [[ -n "$app" ]] && ROUTING_REPORT["$plugin|$app"]+="$line"$'\n'
    done <<<"$out"
  done
}

# One app's report block, from the cache when we have it.
routing_report() {
  local plugin="$1" app="$2" key="$1|$2"
  [[ -n "${ROUTING_REPORT[$key]+set}" ]] || \
    ROUTING_REPORT["$key"]="$(routing_dokku "$plugin:report" "$app")"
  printf '%s' "${ROUTING_REPORT[$key]}"
}

# --- Single-field reports ---------------------------------------------------
#
# `dokku <plugin>:report --<field>` returns just one property and skips the
# expensive work a full report does. `ports:report` inspects the app's image to
# compute its detected ports: 11.9s across 40 apps, against 0.13s for
# `--ports-map`, which is the only part we want.
#
# In bulk it prints one bare line per app, in apps:list order, with no app
# names. We only trust that positional mapping when the line count matches the
# app count exactly, and fall back to parsing full reports when it does not.

declare -gA ROUTING_FIELD=()

# Best effort, and never fatal: callers run under `set -e`, so a failure here
# must leave them running rather than abort the command. Giving up simply means
# routing_field falls back to asking per app.
routing_prewarm_field() {
  local plugin="$1" flag="$2" out apps i
  local -a app_list value_list

  apps="$(routing_list_apps)"
  [[ -n "${apps//[[:space:]]/}" ]] || return 0

  out="$("$DOKKU_BIN" "$plugin:report" "--$flag" 2>/dev/null)" || return 0
  [[ -n "$out" ]] || return 0

  mapfile -t app_list <<<"$apps"
  mapfile -t value_list <<<"$out"
  [[ ${#app_list[@]} -eq ${#value_list[@]} ]] || return 0

  for i in "${!app_list[@]}"; do
    ROUTING_FIELD["$plugin|$flag|${app_list[i]}"]="${value_list[i]}"
  done
  return 0
}

# One property of one app, by whichever route is available.
routing_field() {
  local plugin="$1" flag="$2" label="$3" app="$4" key="$1|$2|$4" value
  if [[ -z "${ROUTING_FIELD[$key]+set}" ]]; then
    if value="$("$DOKKU_BIN" "$plugin:report" "$app" "--$flag" 2>/dev/null)"; then
      ROUTING_FIELD["$key"]="${value%$'\n'}"
    else
      # Older Dokku, or a property this version does not expose as a flag.
      ROUTING_FIELD["$key"]="$(routing_report_field "$(routing_report "$plugin" "$app")" "$label" || true)"
    fi
  fi
  printf '%s' "${ROUTING_FIELD[$key]}"
}

# Warm every report one app needs, in the caller's shell.
#
# Detectors run in subshells and command substitution is itself a subshell, so
# a cache filled inside `$( )` is discarded. Filling it here means the whole
# analysis of one app costs one call per report rather than one per lookup.
routing_prewarm_app() {
  local app="$1" proxy
  # Fill the cache here first; asking through routing_app_proxy would do it
  # inside a command substitution, where the write is discarded.
  routing_field proxy proxy-computed-type "Proxy computed type" "$app" >/dev/null
  proxy="$(routing_app_proxy "$app")"

  routing_field domains domains-app-vhosts "Domains app vhosts" "$app" >/dev/null
  routing_field ports ports-map "Ports map" "$app" >/dev/null
  routing_report checks "$app" >/dev/null

  if routing_provider_exists "$proxy" && routing_provider_inspects "$proxy"; then
    routing_report "$proxy" "$app" >/dev/null
    [[ "$proxy" == "traefik" ]] && routing_report docker-options "$app" >/dev/null
  fi

  routing_app_has_acme "$app" &>/dev/null || true
  routing_trigger_exists || true
  routing_load_plugin_support
}

# Apps with a dokku-letsencrypt certificate.
#
# The whole list costs 2.2s, so only the summary -- which needs every app --
# pays for it. A single app asks letsencrypt:active instead, at 0.14s.
ROUTING_ACME_LOADED=""
ROUTING_ACME_APPS=""
routing_acme_apps() {
  [[ -n "$ROUTING_ACME_LOADED" ]] || {
    ROUTING_ACME_APPS="$(routing_dokku letsencrypt:list | awk 'NR>1 {print $1}')"
    ROUTING_ACME_LOADED="yes"
  }
  printf '%s' "$ROUTING_ACME_APPS"
}

declare -gA ROUTING_ACME_APP=()
routing_app_has_acme() {
  local app="$1"
  if [[ -n "$ROUTING_ACME_LOADED" ]]; then
    routing_acme_apps | grep -qx "$app"
    return
  fi
  [[ -n "${ROUTING_ACME_APP[$app]+set}" ]] || \
    ROUTING_ACME_APP["$app"]="$(routing_dokku letsencrypt:active "$app")"
  [[ "${ROUTING_ACME_APP[$app]}" == "true" ]]
}

# Does any installed plugin implement one of our triggers? Asking plugn per app
# when nothing implements it is pure overhead.
declare -gA ROUTING_TRIGGER=()
routing_trigger_exists() {
  local name="${1:-routing-app-capabilities}"
  if [[ -z "${ROUTING_TRIGGER[$name]+set}" ]]; then
    if compgen -G "${DOKKU_LIB_ROOT:-/var/lib/dokku}/plugins/enabled/*/$name" >/dev/null; then
      ROUTING_TRIGGER["$name"]="yes"
    else
      ROUTING_TRIGGER["$name"]=""
    fi
  fi
  [[ -n "${ROUTING_TRIGGER[$name]}" ]]
}

routing_app_exists() {
  "$DOKKU_BIN" apps:exists "$1" &>/dev/null
}

ROUTING_APPS_LOADED=""
ROUTING_APPS=""
routing_list_apps() {
  [[ -n "$ROUTING_APPS_LOADED" ]] || {
    ROUTING_APPS="$(routing_dokku apps:list | tail -n +2 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^$' || true)"
    ROUTING_APPS_LOADED="yes"
  }
  printf '%s\n' "$ROUTING_APPS"
}

# The proxy an app is currently routed through.
#
# "Proxy type" holds only an explicit per-app override and is usually empty;
# the proxy actually in front of the app is the computed value, which folds in
# the global default. Reading the wrong one reports every app on the global
# proxy as nginx.
routing_app_proxy() {
  local app="$1" proxy
  proxy="$(routing_field proxy proxy-computed-type "Proxy computed type" "$app")"
  [[ -z "$proxy" ]] && proxy="nginx"
  echo "$proxy"
}

routing_app_proxy_enabled() {
  local app="$1" enabled
  enabled="$(routing_field proxy proxy-enabled "Proxy enabled" "$app")"
  [[ "$enabled" == "false" ]] && return 1
  return 0
}

# ---------------------------------------------------------------------------
# Proxy adapters
#
# Adapters are sourced in a subshell so several can be interrogated in one
# run without their function definitions colliding.
# ---------------------------------------------------------------------------

routing_provider_path() {
  echo "$PLUGIN_PROVIDER_ROOT/$1"
}

routing_provider_exists() {
  [[ -f "$(routing_provider_path "$1")" ]]
}

ROUTING_PROVIDERS_LOADED=""
ROUTING_PROVIDERS=""
routing_list_providers() {
  [[ -n "$ROUTING_PROVIDERS_LOADED" ]] || {
    local f
    for f in "$PLUGIN_PROVIDER_ROOT"/*; do
      [[ -f "$f" ]] || continue
      ROUTING_PROVIDERS+="${f##*/}"$'\n'
    done
    ROUTING_PROVIDERS="${ROUTING_PROVIDERS%$'\n'}"
    ROUTING_PROVIDERS_LOADED="yes"
  }
  printf '%s\n' "$ROUTING_PROVIDERS"
}

# Echo one declared metadata variable from an adapter.
routing_provider_meta() {
  local name="$1" var="$2"
  routing_provider_exists "$name" || return 1
  (
    # shellcheck source=/dev/null
    source "$(routing_provider_path "$name")"
    echo "${!var:-}"
  )
}

# Emit "capability<TAB>level<TAB>note" for every capability the adapter grades.
routing_provider_capabilities() {
  local name="$1"
  routing_provider_exists "$name" || return 1
  (
    # shellcheck source=/dev/null
    source "$(routing_provider_path "$name")"
    proxy_capabilities
  )
}

# Read every adapter's matrix into memory once. Sourcing adapters is the only
# expensive part of most commands, and comparisons need all of them anyway.
declare -gA ROUTING_LEVEL=()
declare -gA ROUTING_NOTE=()
ROUTING_LEVELS_LOADED=""

routing_load_levels() {
  routing_load_capabilities
  [[ -n "$ROUTING_LEVELS_LOADED" ]] && return 0
  local provider cap level note
  for provider in $(routing_list_providers); do
    while IFS=$'\t' read -r cap level note; do
      [[ -z "$cap" ]] && continue
      ROUTING_LEVEL["$provider|$cap"]="$level"
      ROUTING_NOTE["$provider|$cap"]="$note"
    done < <(routing_provider_capabilities "$provider")
  done
  ROUTING_LEVELS_LOADED="yes"
}

# Grade of one capability for one proxy: full | partial | none.
# Capabilities an adapter never mentions are treated as unsupported.
routing_provider_level() {
  routing_load_levels
  echo "${ROUTING_LEVEL["$1|$2"]:-none}"
}

routing_provider_note() {
  routing_load_levels
  echo "${ROUTING_NOTE["$1|$2"]:-}"
}

# Emit "capability<TAB>detail<TAB>source" for what an app actually uses.
# Adapters without a detector are metadata-only and contribute nothing.
routing_provider_detect() {
  local name="$1" app="$2"
  routing_provider_exists "$name" || return 1
  (
    # shellcheck source=/dev/null
    source "$(routing_provider_path "$name")"
    declare -F proxy_detect >/dev/null || exit 0
    proxy_detect "$app"
  )
}

# True if the adapter inspects live app state rather than only declaring a
# capability matrix.
routing_provider_inspects() {
  [[ "$(routing_provider_meta "$1" PROXY_INSPECTION)" == "full" ]]
}

# Is this proxy actually installed on the host?
routing_provider_installed() {
  local name="$1" ns
  ns="$(routing_provider_meta "$name" PROXY_DOKKU_PLUGIN)"
  [[ -z "$ns" ]] && return 1
  [[ -d "${DOKKU_LIB_ROOT:-/var/lib/dokku}/plugins/enabled/$ns" ]]
}

# ---------------------------------------------------------------------------
# Third-party contributions
#
# Two channels, per design: a plugn trigger for plugins that opt in, and a
# drop-in directory for plugins that cannot be modified.
# ---------------------------------------------------------------------------

# Capabilities other plugins impose on an app.
# Emits "capability<TAB>detail<TAB>source".
routing_contrib_app_capabilities() {
  local app="$1" f

  if routing_trigger_exists && command -v "$PLUGN_BIN" &>/dev/null; then
    "$PLUGN_BIN" trigger routing-app-capabilities "$app" 2>/dev/null || true
  fi

  for f in "$PLUGIN_CONTRIB_ROOT"/*.sh; do
    [[ -f "$f" ]] || continue
    (
      # shellcheck source=/dev/null
      source "$f"
      declare -F contrib_app_capabilities >/dev/null || exit 0
      contrib_app_capabilities "$app"
    )
  done
}

# Config files another plugin generates for this app.
#
# A file in nginx.conf.d is opaque to us, so it forces manual review -- rightly,
# when a human wrote it. But when a plugin generated it, that plugin already
# knows what it means and says so through routing-app-capabilities. Claiming the
# file here says "this is mine, and I have already told you what it does",
# which keeps generated config from masquerading as hand-written config.
#
# Emits one absolute path per line.
routing_owned_config_paths() {
  local app="$1" f

  if routing_trigger_exists routing-owned-config && command -v "$PLUGN_BIN" &>/dev/null; then
    "$PLUGN_BIN" trigger routing-owned-config "$app" 2>/dev/null || true
  fi

  for f in "$PLUGIN_CONTRIB_ROOT"/*.sh; do
    [[ -f "$f" ]] || continue
    (
      # shellcheck source=/dev/null
      source "$f"
      declare -F contrib_owned_config >/dev/null || exit 0
      contrib_owned_config "$app"
    )
  done
}

# True if some other plugin has claimed this config file.
routing_config_is_owned() {
  local app="$1" path="$2"
  routing_owned_config_paths "$app" | grep -qxF "$path"
}

# Which proxies other plugins say they work with.
# Emits "plugin<TAB>proxy<TAB>level<TAB>note".
routing_contrib_proxy_support() {
  local f

  if command -v "$PLUGN_BIN" &>/dev/null; then
    "$PLUGN_BIN" trigger routing-proxy-support 2>/dev/null || true
  fi

  for f in "$PLUGIN_CONTRIB_ROOT"/*.sh; do
    [[ -f "$f" ]] || continue
    (
      # shellcheck source=/dev/null
      source "$f"
      declare -F contrib_proxy_support >/dev/null || exit 0
      contrib_proxy_support
    )
  done
}

# Everything an app uses: its current proxy's detector plus contributions,
# deduplicated on capability+source.
routing_app_capabilities() {
  local app="$1" proxy="$2"
  {
    routing_provider_detect "$proxy" "$app"
    routing_contrib_app_capabilities "$app"
  } | awk -F'\t' 'NF>=1 && $1!="" && !seen[$1 FS $2 FS $3]++'
}

# ---------------------------------------------------------------------------
# Shared detection
#
# Everything Dokku core owns looks the same whatever proxy is in front of it,
# so adapters share one detector for it and only implement their own quirks.
# ---------------------------------------------------------------------------

routing_detect_common() {
  local app="$1" report value

  value="$(routing_field domains domains-app-vhosts "Domains app vhosts" "$app")"
  if [[ -n "$value" ]]; then
    printf 'domains\t%s\tdomains\n' "$value"
    [[ "$value" == *"*"* ]] && printf 'wildcard-domains\t%s\tdomains\n' "$value"
  fi

  # Port maps live in ports:report, not proxy:report. "Ports map detected" is
  # what the image exposes, which is not a routing decision -- only the
  # configured map is.
  value="$(routing_field ports ports-map "Ports map" "$app")"
  if [[ -n "$value" ]]; then
    printf 'port-mapping\t%s\tports:set\n' "$value"
    local mapping
    for mapping in $value; do
      case "${mapping%%:*}" in
        http | https) ;;
        *) printf 'non-http-ports\t%s\tports:set\n' "$mapping" ;;
      esac
    done
  fi

  if [[ -f "$DOKKU_ROOT/$app/tls/server.crt" ]]; then
    printf 'tls\tcertificate installed\tcerts\n'
    # dokku-letsencrypt copies the cert it installed to server.letsencrypt.crt
    # so it can recognise its own. Without that marker the certificate was put
    # there by hand, and only then is it something an operator has to carry.
    if [[ ! -f "$DOKKU_ROOT/$app/tls/server.letsencrypt.crt" ]]; then
      printf 'tls-custom-cert\t%s\tcerts\n' "$DOKKU_ROOT/$app/tls/server.crt"
    fi
  fi

  if routing_app_has_acme "$app"; then
    printf 'tls-acme\tmanaged by dokku-letsencrypt\tletsencrypt\n'
  fi

  # Only checks someone actually changed. "Wait to retire" is almost always the
  # inherited default, so a skipped or disabled list is the real signal.
  report="$(routing_report checks "$app")"
  local key
  for key in "disabled list" "skipped list"; do
    value="$(routing_report_field "$report" "Checks $key" || true)"
    [[ -z "$value" || "$value" == "none" ]] && continue
    printf 'deploy-checks\t%s=%s\tchecks\n' "${key// /-}" "$value"
  done
  value="$(routing_report_field "$report" "Checks wait to retire" || true)"
  [[ -n "$value" ]] && printf 'deploy-checks\twait-to-retire=%s\tchecks\n' "$value"
}

# Report app-level properties from a `dokku <plugin>:report` block as vendor
# settings. `prefix` is stripped from the field label; `skip_re` is an extended
# regex of labels already claimed by a more specific capability.
routing_detect_vendor_settings() {
  local report="$1" prefix="$2" source="$3" skip_re="${4:-}" line field value

  while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ "$line" == *:* ]] || continue
    [[ "$line" == "$prefix "* ]] || continue
    field="${line%%:*}"
    value="${line#*:}"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    [[ -z "$value" ]] && continue
    field="${field#"$prefix "}"
    # Dokku reports each property three times: the app-level override, the
    # global default, and the "computed" effective value. Only the first is a
    # decision someone made about this app; the other two are noise that would
    # make every app look heavily customised.
    [[ "$field" == computed\ * || "$field" == global\ * ]] && continue
    [[ -n "$skip_re" ]] && [[ "$field" =~ $skip_re ]] && continue
    printf 'vendor-settings\t%s=%s\t%s\n' "${field// /-}" "$value" "$source"
  done <<<"$report"
}

# ---------------------------------------------------------------------------
# Classification
# ---------------------------------------------------------------------------

# routing_classify <capability> <target-proxy>
# -> portable | translatable | manual | unsupported
#
# Also sets ROUTING_CLASS. A full summary classifies thousands of times, and
# every `$(...)` is a fork; callers in that loop read the variable instead.
# Kept free of command substitution internally for the same reason.
routing_classify() {
  local cap="$1" target="$2" sources="${3:-}" level ownership
  routing_load_levels
  # Load here, in the caller's shell. routing_integration_limit runs inside a
  # command substitution, so a cache filled there is thrown away and every
  # single classification would re-run the plugn trigger.
  [[ -n "$sources" ]] && routing_load_plugin_support
  level="${ROUTING_LEVEL["$target|$cap"]:-none}"
  ownership="${ROUTING_CAP_FIELD["$cap|ownership"]:-proxy}"

  if [[ "$level" == "none" ]]; then
    ROUTING_CLASS="unsupported"
  elif [[ "$ownership" == "opaque" || "$level" == "partial" ]]; then
    ROUTING_CLASS="manual"
  elif [[ "$ownership" == "dokku" ]]; then
    ROUTING_CLASS="portable"
  else
    ROUTING_CLASS="translatable"
  fi

  # If a plugin provided this capability and does not support the target, its
  # own limit applies on top of the proxy's.
  local source limit
  for source in $sources; do
    limit="$(routing_integration_limit "$source" "$target")"
    [[ -n "$limit" ]] || continue
    if [[ "$(routing_class_rank "$limit")" -gt "$(routing_class_rank "$ROUTING_CLASS")" ]]; then
      ROUTING_CLASS="$limit"
    fi
  done

  printf '%s\n' "$ROUTING_CLASS"
}

# A capability contributed by another plugin is only as portable as that plugin.
# Traefik can do forward auth; if the plugin providing it has no Traefik
# integration, the app still loses its protection on the way over. The proxy
# supporting a capability and the integration surviving are different questions.
declare -gA ROUTING_PLUGIN_SUPPORT=()
declare -gA ROUTING_PLUGIN_NOTE=()
ROUTING_PLUGIN_SUPPORT_LOADED=""

routing_load_plugin_support() {
  [[ -n "$ROUTING_PLUGIN_SUPPORT_LOADED" ]] && return 0
  ROUTING_PLUGIN_SUPPORT_LOADED="yes"
  local plugin proxy level note
  while IFS=$'\t' read -r plugin proxy level note; do
    [[ -z "$plugin" ]] && continue
    ROUTING_PLUGIN_SUPPORT["$plugin|$proxy"]="$level"
    ROUTING_PLUGIN_NOTE["$plugin|$proxy"]="$note"
  done <<<"$(routing_contrib_proxy_support)"
  return 0
}

# Why a contributed capability cannot follow the app, in the contributing
# plugin's own words. Empty when the plugin is fine with this target.
routing_integration_reason() {
  local sources="$1" target="$2" source plugin level
  routing_load_plugin_support
  for source in $sources; do
    plugin="${source%%:*}"
    [[ -n "$plugin" ]] || continue
    level="${ROUTING_PLUGIN_SUPPORT["$plugin|$target"]:-}"
    case "$level" in
      none | partial)
        printf '%s does not support %s: %s\n' \
          "$plugin" "$target" "${ROUTING_PLUGIN_NOTE["$plugin|$target"]:-no integration}"
        return 0
        ;;
    esac
  done
}

# Sources look like "sso:protect"; the part before the colon names the plugin,
# which is how a contributed capability is tied back to its declaration.
routing_integration_limit() {
  local source="$1" target="$2" plugin level
  plugin="${source%%:*}"
  [[ -n "$plugin" ]] || return 0
  routing_load_plugin_support
  level="${ROUTING_PLUGIN_SUPPORT["$plugin|$target"]:-}"
  case "$level" in
    none) echo "unsupported" ;;
    partial) echo "manual" ;;
  esac
  return 0
}

# Severity ordering, so a limit can only ever make a verdict worse.
routing_class_rank() {
  case "$1" in
    portable) echo 0 ;;
    translatable) echo 1 ;;
    manual) echo 2 ;;
    unsupported) echo 3 ;;
    *) echo -1 ;;
  esac
}

# Every source that reported a capability for this app, space separated.
routing_capability_sources() {
  local detected="$1" cap="$2"
  awk -F'\t' -v c="$cap" '$1==c {print $3}' <<<"$detected" | sort -u | tr '\n' ' '
}

routing_class_symbol() {
  case "$1" in
    portable) echo "✅" ;;
    translatable) echo "🔄" ;;
    manual) echo "⚠ " ;;
    unsupported) echo "❌" ;;
    *) echo "  " ;;
  esac
}

routing_class_label() {
  case "$1" in
    portable) echo "Portable" ;;
    translatable) echo "Auto-translatable" ;;
    manual) echo "Manual migration required" ;;
    unsupported) echo "Unsupported" ;;
  esac
}

routing_level_symbol() {
  case "$1" in
    full) echo "✓" ;;
    partial) echo "~" ;;
    *) echo "✗" ;;
  esac
}

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------

routing_json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\t'/\\t}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/}"
  printf '%s' "$s"
}

routing_json_string() {
  printf '"%s"' "$(routing_json_escape "$1")"
}

# Consume --format <fmt> / --format=<fmt> from the argument list.
# Sets ROUTING_FORMAT and re-exports the remaining args in ROUTING_ARGS.
routing_parse_format() {
  ROUTING_FORMAT="text"
  ROUTING_ARGS=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --format) ROUTING_FORMAT="${2:-}"; shift 2 ;;
      --format=*) ROUTING_FORMAT="${1#--format=}"; shift ;;
      *) ROUTING_ARGS+=("$1"); shift ;;
    esac
  done
  case "$ROUTING_FORMAT" in
    text|json) ;;
    *) echo "!     Unknown format '$ROUTING_FORMAT' (expected text or json)" >&2; return 1 ;;
  esac
}
