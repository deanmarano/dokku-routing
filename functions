#!/usr/bin/env bash

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/capabilities"

# ---------------------------------------------------------------------------
# Dokku helpers
# ---------------------------------------------------------------------------

# Run a dokku command, swallowing failures. Plugins we ask about may not be
# installed, and a missing report is information, not an error.
routing_dokku() {
  "$DOKKU_BIN" "$@" 2>/dev/null || true
}

# True if a dokku command namespace exists on this host.
routing_dokku_has() {
  "$DOKKU_BIN" "$1" --help &>/dev/null || "$DOKKU_BIN" "$1" &>/dev/null
}

# Pull a single field out of a `dokku *:report` block.
#
#   routing_report_field "$report" "Nginx client max body size"
#
# Report lines are "       Nginx client max body size:    10m".
routing_report_field() {
  local report="$1" field="$2" line
  while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ "$line" == "$field:"* ]] || continue
    line="${line#"$field:"}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    echo "$line"
    return 0
  done <<<"$report"
  return 1
}

routing_app_exists() {
  "$DOKKU_BIN" apps:exists "$1" &>/dev/null
}

routing_list_apps() {
  routing_dokku apps:list | tail -n +2 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^$' || true
}

# The proxy an app is currently routed through.
routing_app_proxy() {
  local app="$1" report proxy
  report="$(routing_dokku proxy:report "$app")"
  proxy="$(routing_report_field "$report" "Proxy type" || true)"
  [[ -z "$proxy" ]] && proxy="nginx"
  echo "$proxy"
}

routing_app_proxy_enabled() {
  local app="$1" report enabled
  report="$(routing_dokku proxy:report "$app")"
  enabled="$(routing_report_field "$report" "Proxy enabled" || true)"
  [[ "$enabled" == "false" ]] && return 1
  return 0
}

# ---------------------------------------------------------------------------
# Proxy adapters
#
# Adapters are sourced in a subshell so several can be interrogated in one
# run without their function definitions colliding.
# ---------------------------------------------------------------------------

routing_provider_path() {
  echo "$PLUGIN_PROVIDER_ROOT/$1"
}

routing_provider_exists() {
  [[ -f "$(routing_provider_path "$1")" ]]
}

routing_list_providers() {
  local f
  for f in "$PLUGIN_PROVIDER_ROOT"/*; do
    [[ -f "$f" ]] || continue
    basename "$f"
  done
}

# Echo one declared metadata variable from an adapter.
routing_provider_meta() {
  local name="$1" var="$2"
  routing_provider_exists "$name" || return 1
  (
    # shellcheck source=/dev/null
    source "$(routing_provider_path "$name")"
    echo "${!var:-}"
  )
}

# Emit "capability<TAB>level<TAB>note" for every capability the adapter grades.
routing_provider_capabilities() {
  local name="$1"
  routing_provider_exists "$name" || return 1
  (
    # shellcheck source=/dev/null
    source "$(routing_provider_path "$name")"
    proxy_capabilities
  )
}

# Read every adapter's matrix into memory once. Sourcing adapters is the only
# expensive part of most commands, and comparisons need all of them anyway.
declare -gA ROUTING_LEVEL=()
declare -gA ROUTING_NOTE=()
ROUTING_LEVELS_LOADED=""

routing_load_levels() {
  [[ -n "$ROUTING_LEVELS_LOADED" ]] && return 0
  local provider cap level note
  for provider in $(routing_list_providers); do
    while IFS=$'\t' read -r cap level note; do
      [[ -z "$cap" ]] && continue
      ROUTING_LEVEL["$provider|$cap"]="$level"
      ROUTING_NOTE["$provider|$cap"]="$note"
    done < <(routing_provider_capabilities "$provider")
  done
  ROUTING_LEVELS_LOADED="yes"
}

# Grade of one capability for one proxy: full | partial | none.
# Capabilities an adapter never mentions are treated as unsupported.
routing_provider_level() {
  routing_load_levels
  echo "${ROUTING_LEVEL["$1|$2"]:-none}"
}

routing_provider_note() {
  routing_load_levels
  echo "${ROUTING_NOTE["$1|$2"]:-}"
}

# Emit "capability<TAB>detail<TAB>source" for what an app actually uses.
# Adapters without a detector are metadata-only and contribute nothing.
routing_provider_detect() {
  local name="$1" app="$2"
  routing_provider_exists "$name" || return 1
  (
    # shellcheck source=/dev/null
    source "$(routing_provider_path "$name")"
    declare -F proxy_detect >/dev/null || exit 0
    proxy_detect "$app"
  )
}

# True if the adapter inspects live app state rather than only declaring a
# capability matrix.
routing_provider_inspects() {
  [[ "$(routing_provider_meta "$1" PROXY_INSPECTION)" == "full" ]]
}

# Is this proxy actually installed on the host?
routing_provider_installed() {
  local name="$1" ns
  ns="$(routing_provider_meta "$name" PROXY_DOKKU_PLUGIN)"
  [[ -z "$ns" ]] && return 1
  [[ -d "${DOKKU_LIB_ROOT:-/var/lib/dokku}/plugins/enabled/$ns" ]]
}

# ---------------------------------------------------------------------------
# Third-party contributions
#
# Two channels, per design: a plugn trigger for plugins that opt in, and a
# drop-in directory for plugins that cannot be modified.
# ---------------------------------------------------------------------------

# Capabilities other plugins impose on an app.
# Emits "capability<TAB>detail<TAB>source".
routing_contrib_app_capabilities() {
  local app="$1" f

  if command -v "$PLUGN_BIN" &>/dev/null; then
    "$PLUGN_BIN" trigger routing-app-capabilities "$app" 2>/dev/null || true
  fi

  for f in "$PLUGIN_CONTRIB_ROOT"/*.sh; do
    [[ -f "$f" ]] || continue
    (
      # shellcheck source=/dev/null
      source "$f"
      declare -F contrib_app_capabilities >/dev/null || exit 0
      contrib_app_capabilities "$app"
    )
  done
}

# Which proxies other plugins say they work with.
# Emits "plugin<TAB>proxy<TAB>level<TAB>note".
routing_contrib_proxy_support() {
  local f

  if command -v "$PLUGN_BIN" &>/dev/null; then
    "$PLUGN_BIN" trigger routing-proxy-support 2>/dev/null || true
  fi

  for f in "$PLUGIN_CONTRIB_ROOT"/*.sh; do
    [[ -f "$f" ]] || continue
    (
      # shellcheck source=/dev/null
      source "$f"
      declare -F contrib_proxy_support >/dev/null || exit 0
      contrib_proxy_support
    )
  done
}

# Everything an app uses: its current proxy's detector plus contributions,
# deduplicated on capability+source.
routing_app_capabilities() {
  local app="$1" proxy="$2"
  {
    routing_provider_detect "$proxy" "$app"
    routing_contrib_app_capabilities "$app"
  } | awk -F'\t' 'NF>=1 && $1!="" && !seen[$1 FS $3]++'
}

# ---------------------------------------------------------------------------
# Shared detection
#
# Everything Dokku core owns looks the same whatever proxy is in front of it,
# so adapters share one detector for it and only implement their own quirks.
# ---------------------------------------------------------------------------

routing_detect_common() {
  local app="$1" report value

  report="$(routing_dokku domains:report "$app")"
  value="$(routing_report_field "$report" "Domains app vhosts" || true)"
  if [[ -n "$value" ]]; then
    printf 'domains\t%s\tdomains\n' "$value"
    [[ "$value" == *"*"* ]] && printf 'wildcard-domains\t%s\tdomains\n' "$value"
  fi

  report="$(routing_dokku proxy:report "$app")"
  value="$(routing_report_field "$report" "Proxy port map" || true)"
  if [[ -n "$value" ]]; then
    printf 'port-mapping\t%s\tproxy:ports\n' "$value"
    local mapping
    for mapping in $value; do
      case "${mapping%%:*}" in
        http | https) ;;
        *) printf 'non-http-ports\t%s\tproxy:ports\n' "$mapping" ;;
      esac
    done
  fi

  if [[ -f "$DOKKU_ROOT/$app/tls/server.crt" ]]; then
    printf 'tls\tcertificate installed\tcerts\n'
    printf 'tls-custom-cert\t%s\tcerts\n' "$DOKKU_ROOT/$app/tls/server.crt"
  fi

  if routing_dokku letsencrypt:list | awk 'NR>1 {print $1}' | grep -qx "$app"; then
    printf 'tls-acme\tmanaged by dokku-letsencrypt\tletsencrypt\n'
  fi

  report="$(routing_dokku checks:report "$app")"
  value="$(routing_report_field "$report" "Checks wait to retire" || true)"
  local skipped
  skipped="$(routing_report_field "$report" "Checks skipped" || true)"
  if [[ -n "$value" && "$skipped" != "_all_" ]]; then
    printf 'deploy-checks\twait-to-retire=%s\tchecks\n' "$value"
  fi
}

# Report app-level properties from a `dokku <plugin>:report` block as vendor
# settings. `prefix` is stripped from the field label; `skip_re` is an extended
# regex of labels already claimed by a more specific capability.
routing_detect_vendor_settings() {
  local report="$1" prefix="$2" source="$3" skip_re="${4:-}" line field value

  while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ "$line" == *:* ]] || continue
    [[ "$line" == "$prefix "* ]] || continue
    field="${line%%:*}"
    value="${line#*:}"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    [[ -z "$value" ]] && continue
    field="${field#"$prefix "}"
    # Dokku reports each property three times: the app-level override, the
    # global default, and the "computed" effective value. Only the first is a
    # decision someone made about this app; the other two are noise that would
    # make every app look heavily customised.
    [[ "$field" == computed\ * || "$field" == global\ * ]] && continue
    [[ -n "$skip_re" ]] && [[ "$field" =~ $skip_re ]] && continue
    printf 'vendor-settings\t%s=%s\t%s\n' "${field// /-}" "$value" "$source"
  done <<<"$report"
}

# ---------------------------------------------------------------------------
# Classification
# ---------------------------------------------------------------------------

# routing_classify <capability> <target-proxy>
# -> portable | translatable | manual | unsupported
routing_classify() {
  local cap="$1" target="$2" level ownership
  level="$(routing_provider_level "$target" "$cap")"
  ownership="$(routing_capability_field "$cap" ownership || echo proxy)"

  [[ "$level" == "none" ]] && { echo unsupported; return; }
  [[ "$ownership" == "opaque" ]] && { echo manual; return; }
  [[ "$level" == "partial" ]] && { echo manual; return; }
  [[ "$ownership" == "dokku" ]] && { echo portable; return; }
  echo translatable
}

routing_class_symbol() {
  case "$1" in
    portable) echo "✅" ;;
    translatable) echo "🔄" ;;
    manual) echo "⚠ " ;;
    unsupported) echo "❌" ;;
    *) echo "  " ;;
  esac
}

routing_class_label() {
  case "$1" in
    portable) echo "Portable" ;;
    translatable) echo "Auto-translatable" ;;
    manual) echo "Manual migration required" ;;
    unsupported) echo "Unsupported" ;;
  esac
}

routing_level_symbol() {
  case "$1" in
    full) echo "✓" ;;
    partial) echo "~" ;;
    *) echo "✗" ;;
  esac
}

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------

routing_json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\t'/\\t}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/}"
  printf '%s' "$s"
}

routing_json_string() {
  printf '"%s"' "$(routing_json_escape "$1")"
}

# Consume --format <fmt> / --format=<fmt> from the argument list.
# Sets ROUTING_FORMAT and re-exports the remaining args in ROUTING_ARGS.
routing_parse_format() {
  ROUTING_FORMAT="text"
  ROUTING_ARGS=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --format) ROUTING_FORMAT="${2:-}"; shift 2 ;;
      --format=*) ROUTING_FORMAT="${1#--format=}"; shift ;;
      *) ROUTING_ARGS+=("$1"); shift ;;
    esac
  done
  case "$ROUTING_FORMAT" in
    text|json) ;;
    *) echo "!     Unknown format '$ROUTING_FORMAT' (expected text or json)" >&2; return 1 ;;
  esac
}
