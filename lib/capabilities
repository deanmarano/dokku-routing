#!/usr/bin/env bash
# Canonical capability registry.
#
# Every proxy adapter grades itself against these keys, and every detector
# reports what an app uses in these terms. Adding a capability here is the
# only place a new routing concern needs to be named.
#
# Format: key|label|category|ownership
#
# ownership decides how a used capability is classified when the target proxy
# supports it:
#
#   dokku   Dokku core owns the state (domains, certs, port maps). It survives
#           a proxy swap untouched, so it is portable as-is.
#   proxy   The value is real and transferable, but each proxy spells it
#           differently, so we have to re-express it -- automatically
#           translatable.
#   opaque  We cannot read the intent out of it (hand-written config, vendor
#           labels). Always manual review, never auto-translated.

routing_capability_registry() {
  cat <<'EOF'
domains|Domains / virtual hosts|routing|dokku
wildcard-domains|Wildcard domains|routing|dokku
path-routing|Path-based routing|routing|proxy
port-mapping|HTTP/HTTPS port mapping|routing|dokku
non-http-ports|Non-HTTP (TCP/UDP) ports|routing|dokku
weighted-routing|Weighted / canary routing|routing|proxy
sticky-sessions|Sticky sessions|routing|proxy
load-balancing|Multi-container load balancing|routing|proxy
tls|TLS termination|tls|dokku
tls-acme|Built-in ACME / Let's Encrypt|tls|proxy
tls-custom-cert|Operator-supplied certificates|tls|dokku
hsts|HSTS headers|tls|proxy
https-redirect|HTTP to HTTPS redirect|tls|proxy
http2|HTTP/2|protocol|proxy
http3|HTTP/3 / QUIC|protocol|proxy
websockets|WebSocket upgrades|protocol|proxy
grpc|gRPC proxying|protocol|proxy
proxy-timeouts|Read / send / connect timeouts|traffic|proxy
body-size-limit|Request body size limit|traffic|proxy
buffering|Response buffering controls|traffic|proxy
compression|Response compression|traffic|proxy
request-headers|Request header manipulation|traffic|proxy
response-headers|Response header manipulation|traffic|proxy
forwarded-headers|X-Forwarded-* handling|traffic|proxy
forward-auth|Forward authentication|security|proxy
basic-auth|HTTP basic auth|security|proxy
rate-limiting|Rate limiting|security|proxy
ip-allowlist|IP allow/deny lists|security|proxy
cors|CORS handling|security|proxy
middleware|Composable middleware chains|config|proxy
deploy-checks|Zero-downtime deploy checks|observability|dokku
health-checks|Proxy-level health checks|observability|proxy
access-logs|Access log location / format|observability|proxy
raw-config|Hand-written proxy config|config|opaque
vendor-settings|Proxy-specific settings|config|opaque
EOF
}

# Index the registry once. Classification asks for a capability's ownership
# thousands of times in a full summary; doing that with a grep per lookup costs
# more than every dokku call combined.
declare -gA ROUTING_CAP_FIELD=()
ROUTING_CAPS_LOADED=""

routing_load_capabilities() {
  [[ -n "$ROUTING_CAPS_LOADED" ]] && return 0
  local key label category ownership
  while IFS='|' read -r key label category ownership; do
    [[ -z "$key" ]] && continue
    ROUTING_CAP_FIELD["$key|label"]="$label"
    ROUTING_CAP_FIELD["$key|category"]="$category"
    ROUTING_CAP_FIELD["$key|ownership"]="$ownership"
  done <<<"$(routing_capability_registry)"
  ROUTING_CAPS_LOADED="yes"
}

# Look up one field of a capability. Returns non-zero for unknown keys.
routing_capability_field() {
  routing_load_capabilities
  local value="${ROUTING_CAP_FIELD["$1|$2"]:-}"
  [[ -z "$value" ]] && return 1
  printf '%s\n' "$value"
}

routing_capability_label() {
  routing_capability_field "$1" label || echo "$1"
}

routing_capability_exists() {
  routing_load_capabilities
  [[ -n "${ROUTING_CAP_FIELD["$1|label"]:-}" ]]
}
