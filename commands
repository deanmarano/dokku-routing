#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_BASE_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$PLUGIN_BASE_PATH/config"

[[ " routing " == *" $1 "* ]] || [[ "$1" == "routing:"* ]] || exit "$DOKKU_NOT_IMPLEMENTED_EXIT"

show_help() {
  cat <<EOF
usage: dokku routing[:COMMAND]

Audit and plan migrations between Dokku proxy implementations.

dokku routing commands:

    routing                                    portability summary for every app
    routing:report <app>                        detailed proxy analysis for one app
    routing:plan <app> <target-proxy>           migration plan for moving an app
    routing:list                                installed and available proxies
    routing:compare <proxy> <proxy>             capability matrix for two proxies
    routing:help                                show this message

Classification used by routing:report and routing:plan:

    ✅  Portable                    Dokku owns it; it survives the swap as-is
    🔄  Auto-translatable           real setting, re-expressed for the target
    ⚠   Manual migration required   partial support, or config we cannot read
    ❌  Unsupported                 the target proxy has no equivalent

Most commands accept --format json. routing:plan is text only.
EOF
}

case "$1" in
  routing:help)
    show_help
    ;;
  routing | routing:*)
    if [[ "$1" == "routing" ]]; then
      subcommand="summary"
    else
      subcommand="${1#routing:}"
    fi
    shift

    normalized_subcommand="${subcommand//:/_}"
    normalized_subcommand="${normalized_subcommand//-/_}"
    subcommand_file="$PLUGIN_BASE_PATH/subcommands/$normalized_subcommand"

    if [[ -x "$subcommand_file" ]]; then
      exec "$subcommand_file" "$@"
    else
      echo "Unknown command: routing:$subcommand" >&2
      echo "Run 'dokku routing:help' for usage" >&2
      exit 1
    fi
    ;;
  *)
    exit "$DOKKU_NOT_IMPLEMENTED_EXIT"
    ;;
esac
